{
  "name": "@deepseek-ai/dsh-client-ui-ide-bridge",
  "description": "Web UI: show VS Code active file and cursor line from ideBridge Remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-ide-bridge": "workspace:^",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-api-remotes": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.3-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../../0815deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-remotes": "link:../../../../0815deepseek-harness/packages/api/remotes",
    "@deepseek-ai/dsh-client-locale": "link:../../../../0815deepseek-harness/packages/client/locale",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../../../0815deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../../../0815deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../../../0815deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-typert-protocol": "link:../../../../0815deepseek-harness/packages/typert/protocol",
    "@types/react": "~18.3.1"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
