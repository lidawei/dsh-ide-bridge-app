{
  "name": "@deepseek-ai/dsh-ide-bridge",
  "description": "Host plugin: connect to dsh-ide-vscode WebSocket and expose IDE context via Remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.3-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-home-paths": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.3-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.3-alpha.1",
    "@types/ws": "^8.5.13"
  }
}
